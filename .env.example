NODE_ENV=production
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./var/community-data
# Generate unique values with npm run setup. Preserve ENCRYPTION_KEY with backups.
ENCRYPTION_KEY=
SETUP_TOKEN_HASH=
# Point to the source of the exact version served by your instance.
PUBLIC_SOURCE_URL=https://github.com/internetco/tameduck

# Configure SMTP before relying on email sign-in, invitations or recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional remote computer provider credential.
ASCII_API_KEY=
